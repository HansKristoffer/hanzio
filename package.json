{
  "name": "hanzio",
  "version": "1.2.0",
  "description": "A lightweight set of utility functions for TypeScript",
  "type": "module",
  "module": "./dist/src/index.js",
  "main": "./dist/src/index.js",
  "types": "./dist/index.d.ts",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HansKristoffer/hanzio.git"
  },
  "author": "Kristoffer Hansen",
  "keywords": [
    "typescript",
    "utility",
    "functions",
    "type-safe",
    "exhaustive",
    "union-types"
  ],
  "engines": {
    "bun": ">=1.0.0"
  },
  "files": [
    "src/**/*.ts",
    "dist",
    "!src/**/*.test.ts"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "import": "./dist/src/index.js",
      "default": "./dist/src/index.js"
    },
    "./secrets": {
      "types": "./dist/secrets/index.d.ts",
      "bun": "./src/secrets/index.ts",
      "import": "./dist/src/secrets/index.js",
      "default": "./dist/src/secrets/index.js"
    },
    "./secrets/vite": {
      "types": "./dist/secrets/vite.d.ts",
      "bun": "./src/secrets/vite.ts",
      "import": "./dist/src/secrets/vite.js",
      "default": "./dist/src/secrets/vite.js"
    },
    "./secrets/worker": {
      "types": "./dist/secrets/worker.d.ts",
      "bun": "./src/secrets/worker.ts",
      "import": "./dist/src/secrets/worker.js",
      "default": "./dist/src/secrets/worker.js"
    }
  },
  "scripts": {
    "build": "bun run build:js && bun run build:types",
    "build:js": "bun build ./src/index.ts ./src/zod/index.ts ./src/api-wrapper/index.ts ./src/jwt/index.ts ./src/sitemap/index.ts ./src/p-queue/index.ts ./src/secrets/index.ts ./src/secrets/infisical.ts ./src/secrets/loaders.ts ./src/secrets/vite.ts ./src/secrets/worker.ts --outdir ./dist --target node --packages external",
    "build:types": "tsgo -p tsconfig.build.json",
    "prepublishOnly": "bun run build",
    "test": "bun test",
    "lint": "bun run typecheck && bun biome check",
    "lint:write": "bun run typecheck && bun biome check --write",
    "typecheck": "tsgo --noEmit",
    "prepare": "husky",
    "test:secrets:runtime": "bun run build && node scripts/verify-secrets.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.6",
    "@types/bun": "latest",
    "@typescript/native-preview": "^7.0.0-dev.20260306.1",
    "husky": "^9.1.7",
    "miniflare": "^4.20260730.0",
    "typescript": "^5.7.0",
    "vite": "^8.2.2",
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "zod": "^4.3.6"
  }
}
