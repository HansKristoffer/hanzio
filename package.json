{
  "name": "hanzio",
  "version": "3.3.0",
  "description": "A lightweight set of utility functions for TypeScript",
  "type": "module",
  "module": "./dist/src/index.js",
  "main": "./dist/src/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "hanzio-i18n": "./dist/src/i18n/cli.js"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HansKristoffer/hanzio.git"
  },
  "author": "Kristoffer Hansen",
  "keywords": [
    "typescript",
    "utility",
    "functions",
    "type-safe",
    "exhaustive",
    "union-types"
  ],
  "engines": {
    "bun": ">=1.0.0"
  },
  "files": [
    "src/**/*.ts",
    "src/**/README.md",
    "src/api-wrapper/SKILL.md",
    "dist",
    "!src/**/*.test.ts"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "import": "./dist/src/index.js",
      "default": "./dist/src/index.js"
    },
    "./zod": {
      "types": "./dist/zod/index.d.ts",
      "bun": "./src/zod/index.ts",
      "import": "./dist/src/zod/index.js",
      "default": "./dist/src/zod/index.js"
    },
    "./api-wrapper": {
      "types": "./dist/api-wrapper/index.d.ts",
      "bun": "./src/api-wrapper/index.ts",
      "import": "./dist/src/api-wrapper/index.js",
      "default": "./dist/src/api-wrapper/index.js"
    },
    "./api-wrapper/testing": {
      "types": "./dist/api-wrapper/testing.d.ts",
      "bun": "./src/api-wrapper/testing.ts",
      "import": "./dist/src/api-wrapper/testing.js",
      "default": "./dist/src/api-wrapper/testing.js"
    },
    "./api-wrapper/connection-auth": {
      "types": "./dist/api-wrapper/connection-auth.d.ts",
      "bun": "./src/api-wrapper/connection-auth.ts",
      "import": "./dist/src/api-wrapper/connection-auth.js",
      "default": "./dist/src/api-wrapper/connection-auth.js"
    },
    "./jwt": {
      "types": "./dist/jwt/index.d.ts",
      "bun": "./src/jwt/index.ts",
      "import": "./dist/src/jwt/index.js",
      "default": "./dist/src/jwt/index.js"
    },
    "./sitemap": {
      "types": "./dist/sitemap/index.d.ts",
      "bun": "./src/sitemap/index.ts",
      "import": "./dist/src/sitemap/index.js",
      "default": "./dist/src/sitemap/index.js"
    },
    "./p-queue": {
      "types": "./dist/p-queue/index.d.ts",
      "bun": "./src/p-queue/index.ts",
      "import": "./dist/src/p-queue/index.js",
      "default": "./dist/src/p-queue/index.js"
    },
    "./cool-console-log": {
      "types": "./dist/cool-console-log/index.d.ts",
      "bun": "./src/cool-console-log/index.ts",
      "import": "./dist/src/cool-console-log/index.js",
      "default": "./dist/src/cool-console-log/index.js"
    },
    "./format": {
      "types": "./dist/format/index.d.ts",
      "bun": "./src/format/index.ts",
      "import": "./dist/src/format/index.js",
      "default": "./dist/src/format/index.js"
    },
    "./format/phone": {
      "types": "./dist/format/phone.d.ts",
      "bun": "./src/format/phone.ts",
      "import": "./dist/src/format/phone.js",
      "default": "./dist/src/format/phone.js"
    },
    "./crypto": {
      "types": "./dist/crypto/index.d.ts",
      "bun": "./src/crypto/index.ts",
      "import": "./dist/src/crypto/index.js",
      "default": "./dist/src/crypto/index.js"
    },
    "./crypto/node": {
      "types": "./dist/crypto/node.d.ts",
      "bun": "./src/crypto/node.ts",
      "import": "./dist/src/crypto/node.js",
      "default": "./dist/src/crypto/node.js"
    },
    "./storage": {
      "types": "./dist/storage/index.d.ts",
      "bun": "./src/storage/index.ts",
      "import": "./dist/src/storage/index.js",
      "default": "./dist/src/storage/index.js"
    },
    "./i18n": {
      "types": "./dist/i18n/index.d.ts",
      "bun": "./src/i18n/index.ts",
      "import": "./dist/src/i18n/index.js",
      "default": "./dist/src/i18n/index.js"
    },
    "./i18n/vue": {
      "types": "./dist/i18n/vue.d.ts",
      "bun": "./src/i18n/vue.ts",
      "import": "./dist/src/i18n/vue.js",
      "default": "./dist/src/i18n/vue.js"
    },
    "./i18n/i18next": {
      "types": "./dist/i18n/i18next.d.ts",
      "bun": "./src/i18n/i18next.ts",
      "import": "./dist/src/i18n/i18next.js",
      "default": "./dist/src/i18n/i18next.js"
    },
    "./i18n/vite": {
      "types": "./dist/i18n/vite.d.ts",
      "bun": "./src/i18n/vite.ts",
      "import": "./dist/src/i18n/vite.js",
      "default": "./dist/src/i18n/vite.js"
    },
    "./i18n/check": {
      "types": "./dist/i18n/check.d.ts",
      "bun": "./src/i18n/check.ts",
      "import": "./dist/src/i18n/check.js",
      "default": "./dist/src/i18n/check.js"
    },
    "./iso": {
      "types": "./dist/iso/index.d.ts",
      "bun": "./src/iso/index.ts",
      "import": "./dist/src/iso/index.js",
      "default": "./dist/src/iso/index.js"
    },
    "./secrets": {
      "types": "./dist/secrets/index.d.ts",
      "bun": "./src/secrets/index.ts",
      "import": "./dist/src/secrets/index.js",
      "default": "./dist/src/secrets/index.js"
    },
    "./secrets/vite": {
      "types": "./dist/secrets/vite.d.ts",
      "bun": "./src/secrets/vite.ts",
      "import": "./dist/src/secrets/vite.js",
      "default": "./dist/src/secrets/vite.js"
    },
    "./secrets/worker": {
      "types": "./dist/secrets/worker.d.ts",
      "bun": "./src/secrets/worker.ts",
      "import": "./dist/src/secrets/worker.js",
      "default": "./dist/src/secrets/worker.js"
    },
    "./redis": {
      "types": "./dist/redis/index.d.ts",
      "bun": "./src/redis/index.ts",
      "import": "./dist/src/redis/index.js",
      "default": "./dist/src/redis/index.js"
    },
    "./http": {
      "types": "./dist/http/index.d.ts",
      "bun": "./src/http/index.ts",
      "import": "./dist/src/http/index.js",
      "default": "./dist/src/http/index.js"
    },
    "./cli": {
      "types": "./dist/cli/index.d.ts",
      "bun": "./src/cli/index.ts",
      "import": "./dist/src/cli/index.js",
      "default": "./dist/src/cli/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "bun": "./src/testing/index.ts",
      "import": "./dist/src/testing/index.js",
      "default": "./dist/src/testing/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && bun run build:js && bun run build:types",
    "build:js": "bun build ./src/index.ts ./src/zod/index.ts ./src/api-wrapper/index.ts ./src/api-wrapper/testing.ts ./src/api-wrapper/connection-auth.ts ./src/jwt/index.ts ./src/sitemap/index.ts ./src/p-queue/index.ts ./src/cool-console-log/index.ts ./src/format/index.ts ./src/format/phone.ts ./src/crypto/index.ts ./src/crypto/node.ts ./src/storage/index.ts ./src/i18n/index.ts ./src/i18n/vue.ts ./src/i18n/i18next.ts ./src/i18n/vite.ts ./src/i18n/check.ts ./src/i18n/cli.ts ./src/iso/index.ts ./src/secrets/index.ts ./src/secrets/vite.ts ./src/secrets/worker.ts ./src/redis/index.ts ./src/http/index.ts ./src/cli/index.ts ./src/testing/index.ts --outdir ./dist --target node --packages external --splitting",
    "build:types": "tsgo -p tsconfig.build.json",
    "prepublishOnly": "bun run build",
    "test": "bun test",
    "lint": "bun run typecheck && bun biome check",
    "lint:write": "bun run typecheck && bun biome check --write",
    "typecheck": "tsgo --noEmit",
    "prepare": "husky",
    "test:secrets:runtime": "bun run build && node scripts/verify-secrets.mjs",
    "test:exports": "bun run build && node scripts/verify-exports.mjs",
    "verify:package": "node scripts/verify-package.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.6",
    "@intlify/message-compiler": "^11.4.16",
    "@opentelemetry/api": "^1.9.1",
    "@types/bun": "latest",
    "@typescript/native-preview": "^7.0.0-dev.20260306.1",
    "husky": "^9.1.7",
    "i18next": "^25.10.10",
    "libphonenumber-js": "^1.13.15",
    "miniflare": "^4.20260730.0",
    "typescript": "^5.7.0",
    "vite": "^8.2.2",
    "vue": "^3.5.44",
    "vue-i18n": "^11.4.16",
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "@intlify/message-compiler": ">=10.0.0",
    "i18next": ">=23.0.0",
    "libphonenumber-js": "^1.10.0",
    "vite": ">=6.0.0",
    "vue-i18n": ">=10.0.0",
    "zod": "^4.3.6"
  },
  "peerDependenciesMeta": {
    "@intlify/message-compiler": {
      "optional": true
    },
    "i18next": {
      "optional": true
    },
    "libphonenumber-js": {
      "optional": true
    },
    "vite": {
      "optional": true
    },
    "vue-i18n": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "homepage": "https://github.com/HansKristoffer/hanzio#readme",
  "bugs": {
    "url": "https://github.com/HansKristoffer/hanzio/issues"
  },
  "packageManager": "bun@1.4.2"
}
